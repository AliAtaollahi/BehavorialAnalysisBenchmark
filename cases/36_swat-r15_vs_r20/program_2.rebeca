reactiveclass PLC1(10){
	knownrebecs{
		Pump1 pump1;
		Valve valve;
		SCADA_HMI hmi;
	}
	statevars{
		boolean openReqPlc2;
		boolean pump1On;
		boolean valveOpen;
		boolean autoMode;
	}
	PLC1(){
		openReqPlc2 = false;
		pump1On = false;
		valveOpen = false;
		autoMode = false;
	}

	msgsrv plc1_getSense(int waterLevel){
		hmi.stage(1, waterLevel);
		if (waterLevel == 1 && valveOpen) { valve.valve_close(); valveOpen = false; }
		else if (waterLevel == 1 && !pump1On) { pump1.pump1_on(); pump1On = true; }
		else if (waterLevel == 3 && pump1On) { pump1.pump1_off(); pump1On = false; }
		else if (waterLevel >= 2 && openReqPlc2 && !valveOpen) { valve.valve_open(); valveOpen = true; }
		else if (!openReqPlc2 && valveOpen) { valve.valve_close(); valveOpen = false; }
	}
	msgsrv plc1_openReq(){
		openReqPlc2 = true;
	}
	msgsrv plc1_closeReq(){
		openReqPlc2 = false;
	}

	msgsrv setAutoMode(boolean a){
		autoMode = a;
	}
}

reactiveclass PLC2(10){
	knownrebecs{
		PLC1 plc1;
		SCADA_HMI hmi;
		DosingStation dosing;
	}
	statevars{
		boolean requested;
	}
	PLC2(){
		requested = false;
	}

	msgsrv plc2_getSense(int waterLevel){
		dosing.tankLevel(waterLevel);
		hmi.stage(2, waterLevel);
		if (waterLevel == 1 && !requested) { plc1.plc1_openReq(); requested = true; }
		else if (waterLevel == 2 && requested) { plc1.plc1_closeReq(); requested = false; }
	}
}

reactiveclass PLC3(10){
	knownrebecs{
		Pump2 pump2;
		SCADA_HMI hmi;
		Pump2 pump2b;
	}
	statevars{
		boolean pump2On;
		boolean dutyA;
	}
	PLC3(){
		pump2On = false;
		dutyA = true;
	}

	msgsrv plc3_getSense(int waterLevel){
		hmi.stage(3, waterLevel);

		if (waterLevel == 2 && !pump2On) {
			if (dutyA) pump2.pump2_on(); else pump2b.pump2_on();
			pump2On = true;
		} else if (waterLevel == 1 && pump2On) {
			if (dutyA) pump2.pump2_off(); else pump2b.pump2_off();
			pump2On = false;
			dutyA = !dutyA;
		}
	}
}

reactiveclass Tank1(10){
	knownrebecs{
		sensorTank1 sensor;
		Tank2 tank2;
		TurbidityAnalyser analyser;
	}
	statevars{
		int level;
		boolean pumping;
		boolean draining;
	}
	Tank1(){
		level = 1;
		pumping = false;
		draining = false;
	}
	msgsrv tank1_pump(boolean on){
		pumping = on;
	}
	msgsrv tank1_valve(boolean open){
		draining = open;
	}

	msgsrv tank1_status(){
		if (pumping && level < 3) level = level + ?(0, 1);
		if (draining && level > 1) {
			level = level - 1;
			tank2.tank2_waterIncrease();
		}
		sensor.sensor1_reportStatus(level);
		analyser.sample();
	}
}

reactiveclass Tank2(10){
	knownrebecs{
		sensorTank2 sensor;
		reverseUnit unit;
	}
	statevars{
		int level;
	}
	Tank2(){
		level = 1;
	}
	msgsrv tank2_waterIncrease(){
		if (level < 2) level = level + 1;
	}
	msgsrv tank2_waterDecrease(){
		if (level > 1) level = level - 1;
	}

	msgsrv tank2_status(){
		if (level == 2) unit.cleanWater();
		sensor.sensor2_reportStatus(level);
	}
}

reactiveclass Tank3(10){
	knownrebecs{
		sensorTank3 sensor;
		ProductTank product;
	}
	statevars{
		int level;
		boolean delivering;
	}
	Tank3(){
		level = 1;
		delivering = false;
	}
	msgsrv tank3_pump(boolean on){
		delivering = on;
	}
	msgsrv tank3_waterIncrease(){
		if (level < 2) level = level + 1;
	}

	msgsrv tank3_status(){
		if (delivering && level > 1) level = level - 1;
		if (delivering) product.fill();
		sensor.sensor3_reportStatus(level);
	}
}

reactiveclass sensorTank1(10){
	knownrebecs{
		Tank1 tank1;
		PLC1 plc1;
		Historian historian;
	}
	sensorTank1(){
		self.sensor1_sense();
	}
	msgsrv sensor1_sense(){
		tank1.tank1_status();
		self.sensor1_sense() after(3);
	}
	msgsrv sensor1_reportStatus(int waterLevel){
		plc1.plc1_getSense(waterLevel);
		historian.archive(1, waterLevel);
	}
}

reactiveclass sensorTank2(10){
	knownrebecs{
		Tank2 tank2;
		PLC2 plc2;
		Historian historian;
	}
	sensorTank2(){
		self.sensor2_sense() after(1);
	}
	msgsrv sensor2_sense(){
		tank2.tank2_status();
		self.sensor2_sense() after(3);
	}
	msgsrv sensor2_reportStatus(int waterLevel){
		plc2.plc2_getSense(waterLevel);
		historian.archive(2, waterLevel);
	}
}

reactiveclass sensorTank3(10){
	knownrebecs{
		Tank3 tank3;
		PLC3 plc3;
		Historian historian;
	}
	sensorTank3(){
		self.sensor3_sense() after(2);
	}
	msgsrv sensor3_sense(){
		tank3.tank3_status();
		self.sensor3_sense() after(3);
	}
	msgsrv sensor3_reportStatus(int waterLevel){
		plc3.plc3_getSense(waterLevel);
		historian.archive(3, waterLevel);
	}
}

reactiveclass Pump1(10){
	knownrebecs{
		Tank1 tank1;
		IDS ids;
		FlowTransmitter fit101;
	}
	statevars{
		boolean pump1_on;
	}
	Pump1(){
		pump1_on = false;
	}
	msgsrv pump1_on(){
		fit101.flow(true);
		ids.command(1);
		pump1_on = true;
		tank1.tank1_pump(true);
	}
	msgsrv pump1_off(){
		fit101.flow(false);
		ids.command(2);
		pump1_on = false;
		tank1.tank1_pump(false);
	}
}

reactiveclass Valve(10){
	knownrebecs{
		Tank1 tank1;
		IDS ids;
		FlowTransmitter fit201;
	}
	statevars{
		boolean valve_open;
	}
	Valve(){
		valve_open = false;
	}
	msgsrv valve_open(){
		fit201.flow(true);
		ids.command(3);
		valve_open = true;
		tank1.tank1_valve(true);
	}
	msgsrv valve_close(){
		fit201.flow(false);
		ids.command(4);
		valve_open = false;
		tank1.tank1_valve(false);
	}
}

reactiveclass Pump2(10){
	knownrebecs{
		Tank3 tank3;
		UVDechlorinator uv;
	}
	statevars{
		boolean pump2_on;
	}
	Pump2(){
		pump2_on = false;
	}
	msgsrv pump2_on(){
		uv.lamps(true);
		pump2_on = true;
		tank3.tank3_pump(true);
	}
	msgsrv pump2_off(){
		uv.lamps(false);
		pump2_on = false;
		tank3.tank3_pump(false);
	}
}

reactiveclass reverseUnit(5){
	knownrebecs{
		Tank2 tank2;
		Tank3 tank3;
		UltraFiltration uf;
	}
	statevars{
		boolean drinkableWater;
	}
	reverseUnit(){
		drinkableWater = false;
	}

	msgsrv cleanWater(){
		drinkableWater = true;
		uf.filter();
		tank2.tank2_waterDecrease();
		tank3.tank3_waterIncrease();
	}
}

reactiveclass SCADA_HMI(10){
	statevars{
		int level1;
		int level2;
		int level3;
	}
	SCADA_HMI(){
		level1 = 0;
		level2 = 0;
		level3 = 0;
	}
	msgsrv stage(int n, int waterLevel){
		if (n == 1) level1 = waterLevel;
		else if (n == 2) level2 = waterLevel;
		else level3 = waterLevel;
	}
}

reactiveclass Historian(10){
	statevars{
		int lastStage;
		int lastLevel;
	}
	Historian(){
		lastStage = 0;
		lastLevel = 0;
	}
	msgsrv archive(int n, int waterLevel){
		lastStage = n;
		lastLevel = waterLevel;
	}
}

reactiveclass DosingStation(10){
	statevars{
		boolean naoclPump;
		boolean hclPump;
		int ph;
	}
	DosingStation(){
		naoclPump = false;
		hclPump = false;
		ph = 7;
	}
	msgsrv tankLevel(int waterLevel){
		if (waterLevel == 1) naoclPump = true;
		else naoclPump = false;
		self.analyse() after(1);
	}
	msgsrv analyse(){
		ph = ?(7, 8);
		if (ph > 7) hclPump = true;
		else hclPump = false;
	}
}

reactiveclass UltraFiltration(10){
	statevars{
		int batches;
		boolean backwash;
	}
	UltraFiltration(){
		batches = 0;
		backwash = false;
	}
	msgsrv filter(){
		batches = (batches + 1) % 3;
		if (batches == 0) backwash = true;
		else backwash = false;
	}
}

reactiveclass UVDechlorinator(10){
	statevars{
		boolean lampsOn;
	}
	UVDechlorinator(){
		lampsOn = false;
	}
	msgsrv lamps(boolean on){
		lampsOn = on;
	}
}

reactiveclass ProductTank(10){
	statevars{
		int level;
	}
	ProductTank(){
		level = 1;
	}
	msgsrv fill(){
		if (level < 2) level = level + 1;
		self.distribute() after(1);
	}
	msgsrv distribute(){
		if (level > 1) level = level - 1;
	}
}

reactiveclass IDS(10){
	statevars{
		int lastCommand;
		boolean suspicious;
	}
	IDS(){
		lastCommand = 0;
		suspicious = false;
	}
	msgsrv command(int c){
		if (c == lastCommand) suspicious = true;
		lastCommand = c;
	}
}

reactiveclass EngineeringWorkstation(10){
	knownrebecs{
		PLC1 plc1;
	}
	EngineeringWorkstation(){
		self.switchMode() after(3);
	}
	msgsrv switchMode(){
		plc1.setAutoMode(false);
	}
}

reactiveclass FlowTransmitter(10){
	statevars{
		boolean flowing;
	}
	FlowTransmitter(){
		flowing = false;
	}
	msgsrv flow(boolean f){
		flowing = f;
	}
}

reactiveclass TurbidityAnalyser(10){
	statevars{
		int turbidity;
		boolean alarm;
	}
	TurbidityAnalyser(){
		turbidity = 1;
		alarm = false;
	}
	msgsrv sample(){
		turbidity = ?(1, 2);
		if (turbidity == 2) alarm = true;
		else alarm = false;
	}
}

main{
	PLC1 plc1(pump1, valve, hmi):();
	PLC2 plc2(plc1, hmi, dosing):();
	PLC3 plc3(pump2, hmi, pump2b):();

	Pump1 pump1(tank1, ids, fit101):();
	Pump2 pump2(tank3, uv):();
	Valve valve(tank1, ids, fit201):();
	reverseUnit unit(tank2, tank3, uf):();

	Tank1 tank1(sensor1, tank2, analyser):();
	Tank2 tank2(sensor2, unit):();
	Tank3 tank3(sensor3, product):();

	sensorTank1 sensor1(tank1, plc1, historian):();
	sensorTank2 sensor2(tank2, plc2, historian):();
	sensorTank3 sensor3(tank3, plc3, historian):();
	SCADA_HMI hmi():();
	Historian historian():();
	DosingStation dosing():();
	UltraFiltration uf():();
	UVDechlorinator uv():();
	ProductTank product():();
	IDS ids():();
	EngineeringWorkstation engineering(plc1):();
	FlowTransmitter fit101():();
	FlowTransmitter fit201():();
	Pump2 pump2b(tank3, uv):();
	TurbidityAnalyser analyser():();
}

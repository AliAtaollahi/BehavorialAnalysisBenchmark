reactiveclass A(10){
  knownrebecs{ B b; }
  A(){ self.m1(true); }
  msgsrv m1(boolean z){
    if (z) b.m2(); }}

reactiveclass B(10){
  knownrebecs{ A a; }
  statevars {
    boolean x, y;}
  B(){ x = true; }
  msgsrv m2(){
    y = x;
    x = !x;
    if (y)
      self.m2() after (5);
    else
      a.m1(x || y);}}

reactiveclass Dashboard(10){
  knownrebecs{ A a; }
  statevars{ boolean connected; }
  Dashboard(){ connected = true; self.keepAlive(); }
  msgsrv keepAlive(){
    a.m1(false);
    self.keepAlive() after(5);
  }
}

main {
	A a(b):();
	B b(a):();
	Dashboard dashboard(a):();
}

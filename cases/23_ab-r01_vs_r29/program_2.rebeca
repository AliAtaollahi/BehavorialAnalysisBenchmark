reactiveclass A(10){
  knownrebecs{ B b; }
  A(){ self.m1(true); }
  msgsrv m1(boolean z){
    if (z) b.m2(); }}

reactiveclass B(10){
  knownrebecs{ A a; IntegrityMonitor monitor; }
  statevars {
    boolean x, y;}
  B(){ x = true; }
  msgsrv m2(){
    y = x;
    x = !x;
    monitor.inspect(y, x);
    if (y)
      self.m2() after (5);
    else
      a.m1(x || y);}

  msgsrv resetPhase(){
    x = true;
  }
}

reactiveclass IntegrityMonitor(10){
  knownrebecs{ B b; }
  statevars{ int checks; }
  IntegrityMonitor(){ checks = 0; }
  msgsrv inspect(boolean oldPhase, boolean newPhase){
    checks = (checks + 1) % 2;
    if (oldPhase == newPhase) b.resetPhase();
  }
}

main {
	A a(b):();
	B b(a, monitor):();
	IntegrityMonitor monitor(b):();
}

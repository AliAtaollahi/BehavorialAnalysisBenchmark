reactiveclass A(10){
  knownrebecs{ B b; AuditLog audit; }
  A(){ self.m1(true); }
  msgsrv m1(boolean z){
    audit.append(z);
    if (z) b.m2(); }}

reactiveclass B(10){
  knownrebecs{ A a; }
  statevars {
    boolean x, y;}
  B(){ x = true; }
  msgsrv m2(){
    y = x;
    x = !x;
    if (y)
      self.m2() after (5);
    else
      a.m1(x || y);}}

reactiveclass AuditLog(10){
  statevars{ boolean lastRequest; boolean written; }
  AuditLog(){ lastRequest = false; written = false; }
  msgsrv append(boolean z){
    lastRequest = z;
    written = true;
  }
}

main {
	A a(b, audit):();
	B b(a):();
	AuditLog audit():();
}

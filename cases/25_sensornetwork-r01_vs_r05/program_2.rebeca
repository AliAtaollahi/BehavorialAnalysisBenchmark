reactiveclass Sensor(7) {
    knownrebecs {
        Admin admin;
		BatteryMonitor batteryMonitor;
    }

    statevars {
        int id;
        int period;
		byte netDelay;
    }

    Sensor(int myId, int myPeriod) {
        id = myId;
        period = myPeriod;
		netDelay = 1;
        self.doReport();
    }

    msgsrv doReport() {

        admin.report(id, ?(2, 4)) after(netDelay);
        batteryMonitor.battery(id, ?(1, 2));
        self.doReport() after(period);
    }
}

reactiveclass Scientist(7) {
    knownrebecs {
        Admin admin;
    }

    Scientist() { }

    msgsrv abortPlan() {
        admin.ack() after(?(1, 4));
    }
}

reactiveclass Rescue(7) {
    knownrebecs {
        Admin admin;
    }

    Rescue() { }

    msgsrv go() {
        admin.rescueReach() after(?(1, 2));
    }
}

reactiveclass Admin(13) {
    knownrebecs {
        Sensor sensor0;
        Sensor sensor1;
        Scientist scientist;
        Rescue rescue;
    }

    statevars {
        boolean reported0;
        int sensorValue0;
        boolean reported1;
        int sensorValue1;
        boolean sensorFailure;
        boolean danger;
        boolean scientistAck;
        boolean waitingAck;
        boolean scientistReached;
        boolean scientistDead;

		byte rescueDeadline;
		byte netDelay;
		byte adminCheckDelay;
		byte scientistDeadline;
    }

    Admin() {
		rescueDeadline = 5;
		netDelay = 1;
		adminCheckDelay = 10;
		scientistDeadline = 3;
        self.checkSensors() after(5);
    }

    msgsrv report(int sensorId, int value) {
        if (sensorId == 0) {
            reported0 = true;
            sensorValue0 = value;
        } else {
            reported1 = true;
            sensorValue1 = value;
        }
    }

    msgsrv rescueReach() {
        scientistReached = true;
    }

    msgsrv checkSensors() {
        if (reported0) reported0 = false;
        else sensorFailure = true;

        if (reported1) reported1 = false;
        else sensorFailure = true;

        danger = false;
        if (sensorValue0 > 3) danger = true;
        if (sensorValue1 > 3) danger = true;

        if (danger) {
            waitingAck = true;
            scientist.abortPlan() after(netDelay);
            self.checkScientistAck() after(scientistDeadline);
        }

        self.checkSensors() after(adminCheckDelay);
    }

    msgsrv checkRescue() {
        if (!scientistReached) {
            scientistDead = true;
        } else {
            scientistReached = false;
        }
    }

    msgsrv ack() {
        if (waitingAck) scientistAck = true;
    }

    msgsrv checkScientistAck() {
        if (!scientistAck) {
            rescue.go() after(netDelay);
            self.checkRescue() after(rescueDeadline);
        }
        scientistAck = false;
        waitingAck = false;
    }
}

reactiveclass BatteryMonitor(7) {
    statevars {
        boolean low0;
        boolean low1;
    }
    BatteryMonitor() { }
    msgsrv battery(int sensorId, int charge) {
        if (sensorId == 0) {
            if (charge == 1) low0 = true;
            else low0 = false;
        } else {
            if (charge == 1) low1 = true;
            else low1 = false;
        }
    }
}

main {
    Sensor sensor0(admin, batteryMonitor):(0, 10);
    Sensor sensor1(admin, batteryMonitor):(1, 10);
    Scientist scientist(admin):();
    Rescue rescue(admin):();
    Admin admin(sensor0, sensor1, scientist, rescue):();
	BatteryMonitor batteryMonitor():();
}

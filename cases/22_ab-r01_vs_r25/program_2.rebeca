reactiveclass A(10){
  knownrebecs{ B b; }
  A(){ self.m1(true); }
  msgsrv m1(boolean z){
    if (z) b.m2(); }}

reactiveclass B(10){
  knownrebecs{ A a; IDS ids; }
  statevars {
    boolean x, y;}
  B(){ x = true; }
  msgsrv m2(){
    y = x;
    x = !x;
    ids.inspect(x);
    if (y)
      self.m2() after (5);
    else
      a.m1(x || y);}

  msgsrv resetPhase(){
    x = true;
  }
}

reactiveclass IDS(10){
  knownrebecs{ B b; }
  statevars{ boolean lastPhase; }
  IDS(){ lastPhase = false; }
  msgsrv inspect(boolean x){
    if (x == lastPhase) b.resetPhase();
    lastPhase = x;
  }
}

main {
	A a(b):();
	B b(a, ids):();
	IDS ids(b):();
}

reactiveclass A(10){
  knownrebecs{ B b; Dashboard dashboard; }
  A(){ self.m1(true); }
  msgsrv m1(boolean z){
    dashboard.showRequest(z);
    if (z) b.m2(); }}

reactiveclass B(10){
  knownrebecs{ A a; Dashboard dashboard; }
  statevars {
    boolean x, y;}
  B(){ x = true; }
  msgsrv m2(){
    dashboard.showPhase(x);
    y = x;
    x = !x;
    if (y)
      self.m2() after (5);
    else
      a.m1(x || y);}}

reactiveclass Dashboard(10){
  statevars{ boolean requestShown; boolean phaseShown; }
  Dashboard(){ requestShown = false; phaseShown = false; }
  msgsrv showRequest(boolean z){
    requestShown = z;
  }
  msgsrv showPhase(boolean x){
    phaseShown = x;
  }
}

main {
	A a(b, dashboard):();
	B b(a, dashboard):();
	Dashboard dashboard():();
}

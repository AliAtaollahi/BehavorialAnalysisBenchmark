reactiveclass A(10){
  knownrebecs{ B b; AuditLog audit; RateLimiter limiter; TraceCollector tracer; }
	statevars{
		boolean throttled;
	}
  A(){ throttled = false; self.m1(true); }
  msgsrv m1(boolean z){
    tracer.span(1);
    limiter.request();
    audit.append(z);
    if (z) b.m2(); }

  msgsrv throttle(boolean t){
    throttled = t;
  }
}

reactiveclass B(10){
  knownrebecs{ A a; StandbyServer standby; IDS ids; Storage storage; TraceCollector tracer; }
  statevars {
    boolean x, y;
		int period;
		boolean persisted;}
  B(){ x = true; period = 0; persisted = false; }
  msgsrv m2(){
    tracer.span(2);
    storage.write(x);
    ids.inspect(x);
    standby.sync(x);
    y = x;
    x = !x;
    if (y)
      self.m2() after (5);
    else
      a.m1(x || y);}

  msgsrv configure(int p){
    period = p;
  }

  msgsrv written(){
    persisted = true;
  }
}

reactiveclass AuditLog(10){
  statevars{ boolean lastRequest; boolean written; }
  AuditLog(){ lastRequest = false; written = false; }
  msgsrv append(boolean z){
    lastRequest = z;
    written = true;
  }
}

reactiveclass StandbyServer(10){
  statevars{ boolean phase; boolean synced; }
  StandbyServer(){ phase = true; synced = false; }
  msgsrv sync(boolean x){
    phase = x;
    synced = true;
  }
}

reactiveclass ConfigServer(10){
  knownrebecs{ B b; }
  ConfigServer(){ self.push(); }
  msgsrv push(){
    b.configure(5);
  }
}

reactiveclass RateLimiter(10){
  knownrebecs{ A a; }
  statevars{ int tokens; }
  RateLimiter(){ tokens = 2; }
  msgsrv request(){
    if (tokens > 0) { tokens = tokens - 1; a.throttle(false); }
    else { tokens = 2; a.throttle(true); }
  }
}

reactiveclass IDS(10){
  statevars{ boolean lastPhase; boolean incident; }
  IDS(){ lastPhase = false; incident = false; }
  msgsrv inspect(boolean x){
    if (x == lastPhase) incident = true;
    lastPhase = x;
  }
}

reactiveclass Storage(10){
  knownrebecs{ B b; }
  statevars{ boolean stored; }
  Storage(){ stored = false; }
  msgsrv write(boolean x){
    stored = x;
    b.written() after(1);
  }
}

reactiveclass TraceCollector(10){
  statevars{ int lastSpan; }
  TraceCollector(){ lastSpan = 0; }
  msgsrv span(int who){
    lastSpan = who;
  }
}

main {
	A a(b, audit, limiter, tracer):();
	B b(a, standby, ids, storage, tracer):();
	AuditLog audit():();
	StandbyServer standby():();
	ConfigServer config(b):();
	RateLimiter limiter(a):();
	IDS ids():();
	Storage storage(b):();
	TraceCollector tracer():();
}
